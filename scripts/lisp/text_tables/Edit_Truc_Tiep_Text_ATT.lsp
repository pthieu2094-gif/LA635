(defun c:edt1 (/ a b nd)
(setvar "cmdecho" 0)
(command "undo" "be")
(setq a (car (nentsel "\nChon thuoc tinh can thay doi: ")))
(while a
	(setq b (entget a))
	(setq nd "3")
	(entmod (subst (cons 1 nd)(assoc 1 b) b))
	(entupd a)
	(setq a (car (nentsel "\nChon thuoc tinh can thay doi: ")))
);;while
(command "undo" "end")
(princ)
)

