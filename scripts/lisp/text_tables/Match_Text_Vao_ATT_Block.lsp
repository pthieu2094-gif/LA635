(defun c:t2a (/ a1 a ddd dt dtm)
(while
	(setq a1 (nentsel "\nChon text: "))
	(setq a (cdr( assoc 1 (entget(car a1)))))
	(if (= nil a)(princ)
		(progn
			(setq ddd (nentsel "\nChon text block thuoc tinh: "))
			(setq DT (car ddd))
			(setq DTM (entget DT))
			(setq DTM (subst (cons 1 a) (assoc 1 DTM) DTM))
			(entmod DTM)
			(entupd DT)
		)	
	)
)
(princ)
)
