(defun C:CL (/ COUNT_1 COUNT_2 DIST OBJECTS_X OBJECTS_Y SCALE
      CENTER CENTER_2 ENTITY_1 ENTITY_2 RADIUS RADIUS_2
      LEFT LEFT_2 RIGHT RIGHT_2 NAME
   BOTTOM BOTTOM_2 TOP TOP_2)
   ;  Set all variables
   (setvar "CMDECHO" 0)
   (setq LYR (getvar "clayer"))
  (setq osm (getvar "osmode"))
   (command "OSNAP" "NON")
   (command "LAYER" "OFF" "BALLOON" "")
   (setq SCALE (getvar "DIMSCALE"))
   (setq DIST (* 1 SCALE))
   ;  Pick all circles
   (princ "\n Select all circles that you want center lines added to:")
   (princ "\n ")
   (setq OBJECTS_X (ssget '((0 . "CIRCLE"))))
   ;  Make two selection sets (Horizontal & Vertical)
   (setq OBJECTS_Y (ssget "P"))
   ;  Main loop to draw horizontal lines
   (setq COUNT_1 0)
   (while (< COUNT_1 (sslength OBJECTS_X))
      (setq ENTITY_1 (entget (ssname OBJECTS_X COUNT_1)))
      (setq CENTER (cdr (assoc 10 ENTITY_1)))
      (setq RADIUS (cdr (assoc 40 ENTITY_1)))
      (setq RIGHT (polar center 0.0 (* 1.5 RADIUS)))
      (setq LEFT (polar RIGHT 3.141592654 (* 3 RADIUS)))
      (setq COUNT_2 (+ COUNT_1 1))
      (while (< COUNT_2 (sslength OBJECTS_X))
         (setq ENTITY_2 (entget (ssname OBJECTS_X COUNT_2)))
         (setq CENTER_2 (cdr (assoc 10 ENTITY_2)))
         (setq COUNT_2 (+ COUNT_2 1))
      )      (command "line" LEFT RIGHT "")
      (setq COUNT_1 (+ COUNT_1 1))
   )      
   ;  Main loop to draw vertical lines
   (setq COUNT_1 0)
   (while (< COUNT_1 (sslength OBJECTS_Y))
      (setq ENTITY_1 (entget (ssname OBJECTS_Y COUNT_1)))
      (setq CENTER (cdr (assoc 10 ENTITY_1)))
      (setq RADIUS (cdr (assoc 40 ENTITY_1)))
      (setq TOP (polar CENTER 1.570796327 (* 1.5 RADIUS)))
      (setq BOTTOM (polar TOP 4.712388981 (* 3 RADIUS)))
      (setq COUNT_2 (+ COUNT_1 1))
      (while (< COUNT_2 (sslength OBJECTS_Y))
         (setq ENTITY_2 (entget (ssname OBJECTS_Y COUNT_2)))
         (setq CENTER_2 (cdr (assoc 10 ENTITY_2)))
         (setq COUNT_2 (+ COUNT_2 1))
      )
      (command "line" TOP BOTTOM "")
      (setq COUNT_1 (+ COUNT_1 1))
   )
   ;  Reset all variables and clean up the drawing
   (command "LAYER" "ON" "BALLOON" "")
   (setvar "osmode" osm)
   (command "redraw")
   (command "layer" "set" LYR "")
   (setvar "CMDECHO" 1)
); end centerlines.lsp

