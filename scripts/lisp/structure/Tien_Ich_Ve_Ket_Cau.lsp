(defun c:mc(/ p p1 kc goc p2 p3 p4 p5 )
	(setvar "CMDECHO" 0)
	(setq osm (getvar "osmode"))
	(setvar "osnapcoord" 0)
	(setq p (getpoint "\n Diem 1 "))
	(setq p1 (getpoint p))
	(setq kc (distance p p1))
	(setq goc (angle p1 p))
	(setq p2 (polar p (+ (* pi -1) goc) (* 0.45 kc)))
	(setq p3 (polar p2 (- goc (/ pi 2)) (* 0.1 kc)))
	(setq p4 (polar p2 (+(* pi -1) goc) (* 0.1 kc)))
	(setq p5 (polar p4 (+ goc (/ pi 2)) (* 0.1 kc)))
	(command "osnap" "off")
	(command "pline" p "w" "0" "0" p2 p3 p5 p4 p1 "")
	(setvar "osmode" osm)
)

