(defun c:HH (/ dk kw p p1 p2 p3 p4 )
	(setvar "CMDECHO" 0)
        (setq osm (getvar "osmode"))
	(if (null dko) (setq dko 12))

        (setq dk (getreal (strcat "\nDuong Kinh <" (rtos dko 2 0) ">: ")))

        (if (null dk) (setq dk dko) (setq dko dk))
        (Initget "C E")
	(setq kw (getkword "\nVe (C/E) : "))
	(COND 
	    ((= kw "C")
	     	(setq p (getpoint " Chon diem : " ))
		(setq p1 (polar p pi (* 0.8 dk)))
		(setq p2 (polar p 0(* 0.8 dk)))
		(setq p3 (polar p (/ pi 2) (* 0.8 dk)))
		(setq p4 (polar p (/ pi -2) (* 0.8 dk)))
		(command "osnap" "off")
		(command ".circle" p "d" dk )
		(command ".line" p1 p2  "")
		(command ".line" p3 p4  "")
	    )
	    ((= KW "E")
		(setq p (getpoint " Chon diem 1 : " ))
	     	(setq p1 (getpoint p ))
	     	(setq goc (angle p1 p))
	     	(setq a (car (list (distance p p1))))
	     	(setq p2 (polar p goc (* 0.8 a)))
	     	(setq p3 (polar p1 (+ (* pi -1) goc) (* 0.8 a) ))
	     	(command "osnap" "off")
	     	(command ".pline" p2 "w" "0" "0" p "w" dk dk p1 "w" "0" "0" p3 "")
	    )
	)
	 (setvar "osmode" osm)
	
)
