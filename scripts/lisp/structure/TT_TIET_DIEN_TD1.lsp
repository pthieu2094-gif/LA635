(defun c:TD1 (/ OBJ W TW BF TF SECTION TEXTCONTENT)
  (setq OBJ (entget (car (entsel))))
  (setq	W  (getstring "Web Height:")
	TW (getstring "Web Thickness:")
	BF (getstring "Flange Width:")
	TF (getstring "Flange Thickness:")
  )
  (setq SECTION (strcat "W." W "x" TW ";" "F." BF "x" TF))
  (setq TEXTCONTENT (assoc 1 OBJ))
  (ENTMOD (subst (CONS 1 SECTION) TEXTCONTENT OBJ))
  (princ)
)
