;THONG SO DAU VAO
(defun c:BMN (/ p1 p2 INPUT NUMBERBOLT DIA PLATE ANGLE1 F P B A p3 p4 p5 p6 p7 p8 p3a p4a p5a p6a p7a p8a p9 p5a1 p5a2 p6a1 p6a2)
  (setvar "cmdecho" 0)
  (setq p1 	(getpoint "\nFirst point:"))
  (setq p2 	(getpoint p1"\nSecond point:"))
  (setq INPUT   (getstring "Number-Bolt-Plate"))
  (setq NUMBERBOLT (atoi(substr INPUT 1 2)))
  (setq DIA (atoi(substr INPUT 3 2)))		;DUONG KINH BOLT
  (setq PLATE (atoi(substr INPUT 5 2)))  	;CHIEU DAY BAN MA
  (setq ANGLE1 (angle p1 p2))
  (IF (> DIA 24)
  (PROGN (setq F 60) (setq P 100) (setq B 120) (setq A 120))				;KHOANG CACH VUON RA CUA BAN MA (A)	
  (PROGN (setq F 50) (setq P 80) (setq B 100) (setq A 100)))				;KHOANG CACH VUON RA CUA BAN MA (A)
  (setq p3  (polar p1  (+ pi ANGLE1) A))
  (setq p4  (polar p3 (+ pi ANGLE1) (* -1 F)))
  (setq p5  (polar p4 (+ pi ANGLE1) (* -1 B)))
  (setq p6  (polar p5 (+ pi ANGLE1) (* -1 P)))
  (setq p7  (polar p6 (+ pi ANGLE1) (* -1 P)))
  (setq p8  (polar p7 (+ pi ANGLE1) (* -1 F)))
  (setq p3a (polar p2 (+ pi ANGLE1) (* -1 A)))
  (setq p4a  (polar p3a (+ pi ANGLE1) F))
  (setq p5a  (polar p4a (+ pi ANGLE1) B))
  (setq p6a  (polar p5a (+ pi ANGLE1) P))
  (setq p7a  (polar p6a (+ pi ANGLE1) P))
  (setq p8a  (polar p7a (+ pi ANGLE1) F))
  (setq p9 (polar p1 (+ pi ANGLE1) (* -1 (* (distance p1 p2) 0.5))))
  (setq p5a1  (polar p5 (+ pi ANGLE1) (* -1 F)))
  (setq p5a2  (polar p5a (+ pi ANGLE1) F))
  (setq p6a1  (polar p6 (+ pi ANGLE1) (* -1 F)))
  (setq p6a2  (polar p6a (+ pi ANGLE1) F))
  (TT_BM1 p1 p2 PLATE DIA)
  (COND ((EQ NUMBERBOLT 44)  		
  		(TT_BL p4 PLATE DIA ANGLE1)
  		(TT_BL p4a PLATE DIA ANGLE1)
  		(TT_BL p5 PLATE DIA ANGLE1)
  		(TT_BL p5a PLATE DIA ANGLE1)
	 	(IF (>=(distance p1 p2) 600)
		    	(PROGN	(TT_ST p5a1 ANGLE1 PLATE)
  				(TT_ST p5a2 ANGLE1 PLATE)))	
	 	(IF (>=(distance p5 p5a) 500)
			(TT_BL p9 PLATE DIA ANGLE1)))
	 ((EQ NUMBERBOLT 66)
	   	(TT_BL p4 PLATE DIA ANGLE1)
  		(TT_BL p4a PLATE DIA ANGLE1)
  		(TT_BL p5 PLATE DIA ANGLE1)
  		(TT_BL p5a PLATE DIA ANGLE1)
  		(TT_BL p6 PLATE DIA ANGLE1)
  		(TT_BL p6a PLATE DIA ANGLE1)
	  	(IF (>=(distance p1 p2) 600)
		    	(PROGN	(TT_ST p6a1 ANGLE1 PLATE)
  				(TT_ST p6a2 ANGLE1 PLATE)))
	  	(IF (>=(distance p6 p6a) 500)
		(TT_BL p9 PLATE DIA ANGLE1)))
	 ((EQ NUMBERBOLT 88)
	   	(TT_BL p4 PLATE DIA ANGLE1)
  		(TT_BL p4a PLATE DIA ANGLE1)
  		(TT_BL p5 PLATE DIA ANGLE1)
  		(TT_BL p5a PLATE DIA ANGLE1)
  		(TT_BL p6 PLATE DIA ANGLE1)
  		(TT_BL p6a PLATE DIA ANGLE1)	   
  		(TT_BL p7 PLATE DIA ANGLE1)
  		(TT_BL p7a PLATE DIA ANGLE1)
	  	(IF (>=(distance p1 p2) 600)
		    	(PROGN	(TT_ST p8 ANGLE1 PLATE)
  				(TT_ST p8a ANGLE1 PLATE)))
	  	(IF (>=(distance p7 p7a) 500)
		(TT_BL p9 PLATE DIA ANGLE1)))
		);DONG COND
  (PRINC));DONG LENH
;HAM VE BU LONG
;DIA :DUONG KINH BU LONG
;PLATE :CHIEU DAY BAN MA
;P0 :TAM BU LONG
;ANGLE1: GOC XOAY BU LONG
(defun TT_BL (p0 PLATE DIA ANGLE1 / p1 p2 x1 x2 a b c p3 p4)
  (setvar "cmdecho" 0)
  (setq p1 (polar p0 (+ (* 0.5 pi) ANGLE1) PLATE))
  (setq p2 (polar p0 (+ (* -0.5 pi) ANGLE1) PLATE))
  (setq x1 (distance p1 p2))
  (setq x2 (* 0.25 x1))
  (setq a (angle p1 p2))
  (setq c(/ PLATE 2))
  (setq p3 (polar p1 (+ a pi) c))
  (setq p4 (polar p2 a c))
  (entmake (list 
	'(0 . "LWPOLYLINE")'(100 . "AcDbEntity") '(67 . 0)'(8 . "43 Bolt") '(100 . "AcDbPolyline")
	'(90 . 4)'(70 . 0) '(38 . 0.0) '(39 . 0.0)
	(cons 10 p3) '(40 . 0.0) '(41 . 0.0) '(42 . 0.0) '(91 . 0)
	(cons 10 p1) (cons 40 DIA) (cons 41 DIA) '(42 . 0.0) '(91 . 0)
	(cons 10 p2) '(40 . 0.0) '(41 . 0.0) '(42 . 0.0) '(91 . 0)
	(cons 10 p4) '(40 . 0.0) '(41 . 0.0) '(42 . 0.0) '(91 . 0)
	'(210 0.0 0.0 1.0))))
;HAM VE BAN MA
;b chieu day ban ma
;b1 duong kinh bu long
(defun TT_BM1 ( p1 p2 b b1 / occho a kw p3 p4 p5 p6 d f)
  (setq occho (getvar "osmode"))
  (setq a (angle p1 p2))
  (IF (> b1 24)
  (setq b2 120)
  (setq b2 100))
  (setq p3 (polar p1 (+ pi a) b2))
  (setq p4 (polar p2 (+ pi a) (* -1 b2)))
  (setq p5 (polar p4 (+ (/ pi 2) a) b))
  (setq p6 (polar p3 (+ (/ pi 2) a) b))
  (setvar "osmode" 16384)
  (command "clayer" "42 Steel plate")
  (command ".pline" p3 p4 p5 p6 "c")
  (setq d(entlast))
  (command "mirror" d"" p1 p2 "n")
  (setvar "osmode" occho)
  (command "clayer" "31 Drawing")
  (princ))
;HAM VE STIFF
(defun TT_ST (p0 ANGLE1 PLATE / PT1 PT2 PT1A PT2A GOC PT3 PT4 PT5 PT6 PT7 PT8 PT9 PT10 tf tw h)
  (setvar "CMDECHO" 0)
  (setq osm (getvar "osmode"))
  (setq PT1 (polar p0 (+ (* 0.5 pi) ANGLE1) PLATE))
  (setq PT2 (polar PT1 (+ (* 0.5 pi) ANGLE1) 100))
  (setq PT1A (polar p0 (+ (* -0.5 pi) ANGLE1) PLATE))
  (setq PT2A (polar PT1A (+ (* -0.5 pi) ANGLE1) 100))
  (setq h 8)
  (setq tf 4
	GOC(angle PT1 PT2)
	PT7(polar PT1 (+ GOC (/ pi 2)) (/ h 2))
	PT8(polar PT2 (+ GOC (/ pi -2)) (/ h 2))
	PT9(polar PT2 (+ GOC (/ pi 2)) (/ h 2))
	PT10(polar PT1 (+ GOC (/ pi -2)) (/ h 2))	)
   (setq tf 4
	GOC(angle PT1A PT2A)
	PT7A(polar PT1A (+ GOC (/ pi 2)) (/ h 2))
	PT8A(polar PT2A (+ GOC (/ pi -2)) (/ h 2))
	PT9A(polar PT2A (+ GOC (/ pi 2)) (/ h 2))
	PT10A(polar PT1A (+ GOC (/ pi -2)) (/ h 2))	)  
  (setvar "osmode" 16384)
  (command "clayer" "33 Flange steel")
  (command "PLINE" PT7 PT9 PT8 PT10 "C")
  (command "PLINE" PT7A PT9A PT8A PT10A "C")
  (command "clayer" "31 Drawing")
  (setvar "osmode" osm)
  (princ)
  );THE END
