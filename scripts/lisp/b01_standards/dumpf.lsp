(defun c:DUMPF ( / ss i e o mn mx f p q nm)
  (vl-load-com)
  (setq f (open "C:/Users/OS/.gemini/antigravity/brain/a004ff9c-b31a-4036-884e-42c622a64472/scratch/frames.txt" "w"))
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (setq i 0)
  (while (< i (sslength ss))
    (setq e (ssname ss i) o (vlax-ename->vla-object e))
    (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list o 'mn 'mx))))
      (progn
        (setq p (vlax-safearray->list mn) q (vlax-safearray->list mx))
        (if (> (- (car q) (car p)) 15000)
          (write-line (strcat (vla-get-effectivename o) " | " (vla-get-layer o) " | h=" (vla-get-handle o)
                              " | ins=" (rtos (car (vlax-get o 'InsertionPoint)) 2 0) "," (rtos (cadr (vlax-get o 'InsertionPoint)) 2 0)
                              " | sc=" (rtos (vla-get-xscalefactor o) 2 3)
                              " | bb=" (rtos (car p) 2 0) "," (rtos (cadr p) 2 0) " -> " (rtos (car q) 2 0) "," (rtos (cadr q) 2 0)) f))))
    (setq i (1+ i)))
  (close f)
  (princ "done")
  (princ))
