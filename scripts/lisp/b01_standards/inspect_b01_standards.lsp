(defun c:INSPECT_B01_STANDARDS ( / ss i e o lay hname)
  (vl-load-com)
  (setq f (open "C:/Users/OS/.gemini/antigravity/brain/a004ff9c-b31a-4036-884e-42c622a64472/scratch/b01_standards.txt" "w"))
  
  ;; 1. Check Hatch in B01 (Y >= -20000, X <= 50000)
  (setq ss (ssget "_X" '((0 . "HATCH"))))
  (setq i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) o (vlax-ename->vla-object e))
    (setq p (vlax-safearray->list (vlax-variant-value (vla-get-elevationpoint o))))
    ;; if near B01 (Y >= -15000 and Y <= 30000, X <= 50000)
    (if (and (> (cadr p) -15000) (< (cadr p) 30000) (< (car p) 50000))
      (write-line (strcat "HATCH lay=" (vla-get-layer o) " pat=" (vla-get-patternname o) " scale=" (rtos (vla-get-patternscale o) 2 2) " angle=" (rtos (vla-get-patternangle o) 2 2)) f))
    (setq i (1+ i)))
    
  ;; 2. Check Blocks in B01 (door/window blocks)
  (setq ss (ssget "_X" '((0 . "INSERT"))))
  (setq i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) o (vlax-ename->vla-object e))
    (setq p (vlax-safearray->list (vlax-variant-value (vla-get-insertionpoint o))))
    (if (and (> (cadr p) -15000) (< (cadr p) 30000) (< (car p) 50000))
      (progn
        (setq bname (vla-get-effectivename o))
        (if (not (wcmatch bname "*GRID*,*A$C*,*DIM*,*TITLE*"))
          (write-line (strcat "BLOCK name=" bname " lay=" (vla-get-layer o) " pos=" (rtos (car p) 2 1) "," (rtos (cadr p) 2 1)) f))))
    (setq i (1+ i)))
    
  ;; 3. Check Wall lines/polylines in B01
  (setq ss (ssget "_X" '((0 . "LWPOLYLINE,POLYLINE") (8 . "*WALL*,*31*"))))
  (setq i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) o (vlax-ename->vla-object e))
    (setq p (vlax-safearray->list (vlax-variant-value (vla-get-coordinate o 0))))
    (if (and (> (cadr p) -15000) (< (cadr p) 30000) (< (car p) 50000))
      (write-line (strcat "POLYLINE lay=" (vla-get-layer o) " closed=" (if (= (vla-get-closed o) :vlax-true) "YES" "NO") " numverts=" (itoa (vla-get-numberofvertices o))) f))
    (setq i (1+ i)))
    
  (close f)
  (princ "\\nInspection done")
  (princ)
)
