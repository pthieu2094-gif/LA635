(defun c:DO_MIRROR ( / f line h e ss count )
  (vl-load-com)
  (setq f (open "C:/Users/OS/.gemini/antigravity/brain/a004ff9c-b31a-4036-884e-42c622a64472/scratch/mirror_handles.txt" "r"))
  (setq ss (ssadd))
  (setq count 0)
  (while (setq line (read-line f))
    (setq h (vl-string-trim " \t\r\n" line))
    (if (/= h "")
      (progn
        (setq e (handent h))
        (if (and e (entget e))
          (progn
            (ssadd e ss)
            (setq count (1+ count))
          )
        )
      )
    )
  )
  (close f)
  (princ (strcat "\nLoaded " (itoa count) " entities to mirror.\n"))
  (if (> (sslength ss) 0)
    (progn
      (setvar "CMDECHO" 1)
      (command "_.MIRROR" ss "" "_non" (list 28700.8 -45000.0 0.0) "_non" (list 28700.8 -48000.0 0.0) "_N")
      (princ "\n_.MIRROR command completed.\n")
    )
    (princ "\nNo valid entities found to mirror.\n")
  )
  (princ)
)
