(defun b02pl (p1 p2)
  (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "32 Gridline") '(100 . "AcDbPolyline")
                 '(90 . 2) '(70 . 0) (cons 10 p1) (cons 10 p2))))
(defun b02frame (x y sc / ms o a)
  (setq ms (vla-get-modelspace (vla-get-activedocument (vlax-get-acad-object))))
  (setq o (vla-insertblock ms (vlax-3d-point x y 0) "A$Ce291ec07" sc sc sc 0))
  (vla-put-layer o "1.NVB-BLACK LINE")
  (foreach a (vlax-invoke o 'GetAttributes)
    (if (= (vla-get-tagstring a) "SCC") (vla-put-textstring a (strcat "1/" (itoa (fix sc))))))
  o)
(defun c:B02GRID ( / XS YS Y0 ox oy lv x y ss i e)
  (vl-load-com)
  ;; delete previous B02 grid
  (setq ss (ssget "_X" '((0 . "LWPOLYLINE") (8 . "32 Gridline"))) i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i))
    (if (< (caddr (assoc 10 (entget e))) -30000) (entdel e))
    (setq i (1+ i)))
  (setq XS '(0 6200 12200 18400 23050 27700 30600 36600)
        YS '(0 8000 14000)
        LV '(0 500 4500 8500 11200)
        Y0 -62000.0)
  ;; Plan + Roof plan
  (foreach dx '(0 90000)
    (foreach x XS (b02pl (list (+ dx x) (- Y0 3000)) (list (+ dx x) (+ Y0 14000 6017))))
    (foreach y YS (b02pl (list (+ dx -9468) (+ Y0 y)) (list (+ dx 36600 3000) (+ Y0 y)))))
  ;; E1 (from A: 1..8 L->R) oy=-53700 ; E4 (from C: 8..1 L->R) oy=-73700
  (setq ox 180000.0)
  (foreach e (list (list -53700.0 nil) (list -73700.0 T))
    (setq oy (car e))
    (foreach x XS
      (setq x (if (cadr e) (- 36600 x) x))
      (b02pl (list (+ ox x) (- oy 4200)) (list (+ ox x) (+ oy 11800))))
    (foreach l LV (b02pl (list (- ox 6000) (+ oy l)) (list (+ ox 36600 1208) (+ oy l)))))
  ;; E2 (from axis1: C-B-A) ox=245400 ; E3 (from axis8: A-B-C) ox=283000 ; oy=-50300
  (setq oy -50300.0)
  (foreach e (list (list 245400.0 T) (list 283000.0 nil))
    (setq ox (car e))
    (foreach y YS
      (setq y (if (cadr e) (- 14000 y) y))
      (b02pl (list (+ ox y) (- oy 3200)) (list (+ ox y) (+ oy 11800))))
    (foreach l LV (b02pl (list (- ox 4000) (+ oy l)) (list (+ ox 14000 1200) (+ oy l)))))
  ;; frames (top aligned at Y=-32608); ins.y = top - 27.78*sc
  (b02frame -14785.0 (- -32608.0 (* 27.78 100)) 100.0)
  (b02frame 75915.0 (- -32608.0 (* 27.78 100)) 100.0)
  (b02frame 161002.0 (- -32608.0 (* 27.78 120)) 120.0)
  (b02frame (- 245400.0 5600 17451) (- -32608.0 (* 27.78 60)) 60.0)
  (b02frame (- 283000.0 5600 17451) (- -32608.0 (* 27.78 60)) 60.0)
  (princ "B02GRID done") (princ))
